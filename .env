# Copy this file to ".env" and fill in your keys.
# NEVER share this file or upload it anywhere.
# Paper mode does NOT need any keys.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Safety switch for REAL money. Live mode only starts if this is exactly "yes"
# AND config.yaml has mode: live.
LIVE_TRADING=no

# Optional password for the web dashboard (http://localhost:8080).
# Leave empty for no password. Any username works; only the password is checked.
